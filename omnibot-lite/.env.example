# omnibot-lite — variables d'environnement (copier en .env ou passer dans docker-compose)

# Serveur LLM OpenAI-compatible (Strata sur le PC Win11 ou Ollama).
# Strata : `strata launch --access lan` puis http://<ip-win11>:8080/v1
# Ollama : OLLAMA_HOST=0.0.0.0 puis http://<ip>:11434/v1
OMNIBOT_LLM_BASE_URL=http://192.168.1.10:8080/v1
OMNIBOT_LLM_MODEL=default
# Clé API fournie par Strata en accès LAN (laisser vide si le serveur n'exige pas de clé)
OMNIBOT_LLM_API_KEY=

# Port du hub (défaut 8080)
OMNIBOT_PORT=8080

# Recherche web (outil `web_search` des bots). Clé sur https://app.tavily.com
# Laisser vide = outil désactivé. Ne jamais committer la vraie clé.
TAVILY_API_KEY=

# Dossier des données (personas, historiques, JSON). Défaut : ./data
# OMNIBOT_DATA_DIR=/srv/omnibot-lite/data
